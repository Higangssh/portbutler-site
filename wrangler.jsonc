{
  // 거의 정적 파일만 올리는 Worker다. `main` 이 생긴 이유는 하나뿐이다 —
  // **`/appcast.xml` 을 우리 주소로 내놓기 위해서**다(worker.js 의 설명).
  // 그 주소가 앱에 박혀서 나가므로 남의 도메인일 수 없다.
  // 형제 사이트(homebutler-site)와 같은 방식이다 — Pages 가 아니라 Workers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portbutler-site",
  "compatibility_date": "2026-09-13",
  // 대시보드에서 손으로 붙인 것과 같은 도메인이다. 여기 적어 두면 배포할 때마다
  // 맞춰지므로, 대시보드에서 실수로 지워도 다음 배포가 되살린다.
  // 주소는 커스텀 도메인 하나뿐이다. workers.dev 임시 주소를 같이 켜두면 같은
  // 쪽이 주소 둘로 뜨고, 검색 엔진이 둘 다 담고, 링크가 두 갈래로 퍼진다.
  // 적어두지 않으면 wrangler 가 매번 "기본값으로 끈다"고 경고한다 — 끄는 것이
  // 맞으니 경고를 없애는 대신 뜻을 적는다.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "portbutler.sshlab.dev", "custom_domain": true }
  ],
  "main": "worker.js",
  "assets": {
    // 워커가 정적 파일을 직접 내주려면 이름표가 있어야 한다.
    "binding": "ASSETS",
    // **올릴 것만 이 폴더에 있다.** 루트를 가리키면 .git 과 설정 파일까지
    // 후보가 되고, 빠뜨리면 저장소가 통째로 공개된다.
    "directory": "./public",
    // 없는 주소는 404 다. single-page-application 으로 두면 오타 난 주소까지
    // 첫 화면을 200 으로 돌려주고, 검색 엔진이 같은 쪽을 여러 주소로 담는다.
    "not_found_handling": "404-page"
  }
}
